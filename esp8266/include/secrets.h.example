#pragma once

// 复制本文件为 secrets.h 后再改。secrets.h 不进仓库。

#define WIFI_SSID "你家的WiFi名"
#define WIFI_PASSWORD "WiFi密码"

// 必须与 Cloudflare 里 DEVICE_TOKEN 相同
#define DEVICE_TOKEN "换成一长串随机字符"

// Worker 自定义域名（不要用 workers.dev，部分网络会污染其 DNS）
#define WAKE_HOST "wake.example.com"

// NAS 网卡 MAC（与路由器里看到的一致）
#define NAS_MAC_0 0xAA
#define NAS_MAC_1 0xBB
#define NAS_MAC_2 0xCC
#define NAS_MAC_3 0xDD
#define NAS_MAC_4 0xEE
#define NAS_MAC_5 0xFF

// 与 NAS 同一子网的广播地址，例如 192.168.1.0/24 → 192.168.1.255
#define WOL_BCAST_0 192
#define WOL_BCAST_1 168
#define WOL_BCAST_2 1
#define WOL_BCAST_3 255
